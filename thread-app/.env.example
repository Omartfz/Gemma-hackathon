# Cloud extract — Gemma via Google AI (default)
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alternate name; either works
GEMMA_CLOUD_MODEL=gemma-4-26b-a4b-it
EXTRACT_CLOUD_PROVIDER=gemma

# Optional fallback if Gemma fails
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Gemma via Ollama (nav → Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Tavily — appointment doc research. Falls back to fixtures if unset.
TAVILY_API_KEY=
